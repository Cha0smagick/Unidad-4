   "source": [
    "# @title Definición de arquitecturas: CustomCNN, ResNet18, EfficientNet-B0\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import timm\n",
    "from torchvision import models\n",
    "from typing import List, Optional\n",
    "\n",
    "class ConvBlock(nn.Module):\n",
    "    \"\"\"Bloque convolucional con BatchNorm, ReLU, Dropout opcional.\"\"\"\n",
    "    def __init__(self, in_channels, out_channels, kernel_size=3, stride=1, padding=1,\n",
    "                 use_batch_norm=True, dropout_rate=0.0):\n",
    "        super().__init__()\n",
    "        layers = []\n",
    "        layers.append(nn.Conv2d(in_channels, out_channels, kernel_size, stride, padding, bias=not use_batch_norm))\n",
    "        if use_batch_norm:\n",
    "            layers.append(nn.BatchNorm2d(out_channels))\n",
    "        layers.append(nn.ReLU(inplace=True))\n",
    "        if dropout_rate > 0:\n",
    "            layers.append(nn.Dropout2d(dropout_rate))\n",
    "        self.block = nn.Sequential(*layers)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        return self.block(x)\n",
    "\n",
    "class CustomCNN(nn.Module):\n",
    "    \"\"\"CNN personalizada para clasificación de imágenes médicas.\"\"\"\n",
    "    def __init__(self, num_classes=2, base_filters=32, filter_progression=None,\n",
    "                 fc_hidden=None, dropout_rate=0.5, use_batch_norm=True):\n",
    "        super().__init__()\n",
    "        \n",
    "        if filter_progression is None:\n",
    "            filter_progression = [base_filters * (2**i) for i in range(4)]  # [32, 64, 128, 256]\n",
    "        if fc_hidden is None:\n",
    "            fc_hidden = [512, 256]\n",
    "        \n",
    "        self.filter_progression = filter_progression\n",
    "        \n",
    "        # Backbone convolucional\n",
    "        self.conv_layers = nn.ModuleList()\n",
    "        in_channels = 3\n",
    "        \n",
    "        for i, out_channels in enumerate(filter_progression):\n",
    "            # Dos conv blocks por etapa\n",
    "            dr = dropout_rate * 0.3 if i > 1 else 0.0\n",
    "            self.conv_layers.append(ConvBlock(in_channels, out_channels, use_batch_norm=use_batch_norm, dropout_rate=dr))\n",
    "            self.conv_layers.append(ConvBlock(out_channels, out_channels, use_batch_norm=use_batch_norm, dropout_rate=dr))\n",
    "            self.conv_layers.append(nn.MaxPool2d(2, 2))\n",
    "            in_channels = out_channels\n",
    "        \n",
    "        # Global Average Pooling\n",
    "        self.global_pool = nn.AdaptiveAvgPool2d((1, 1))\n",
    "        \n",
    "        # Clasificador\n",
    "        classifier_layers = []\n",
    "        prev_dim = filter_progression[-1]\n",
    "        for hidden_dim in fc_hidden:\n",
    "            classifier_layers.extend([\n",
    "                nn.Linear(prev_dim, hidden_dim),\n",
    "                nn.BatchNorm1d(hidden_dim) if use_batch_norm else nn.Identity(),\n",
    "                nn.ReLU(inplace=True),\n",
    "                nn.Dropout(dropout_rate)\n",
    "            ])\n",
    "            prev_dim = hidden_dim\n",
    "        classifier_layers.append(nn.Linear(prev_dim, num_classes))\n",
    "        \n",
    "        self.classifier = nn.Sequential(*classifier_layers)\n",
    "        self._initialize_weights()\n",
    "    \n",
    "    def _initialize_weights(self):\n",
    "        for m in self.modules():\n",
    "            if isinstance(m, nn.Conv2d):\n",
    "                nn.init.kaiming_normal_(m.weight, mode='fan_out', nonlinearity='relu')\n",
    "            elif isinstance(m, (nn.BatchNorm2d, nn.BatchNorm1d)):\n",
    "                nn.init.constant_(m.weight, 1)\n",
    "                nn.init.constant_(m.bias, 0)\n",
    "            elif isinstance(m, nn.Linear):\n",
    "                nn.init.normal_(m.weight, 0, 0.01)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        for layer in self.conv_layers:\n",
    "            x = layer(x)\n",
    "        x = self.global_pool(x)\n",
    "        x = torch.flatten(x, 1)\n",
    "        x = self.classifier(x)\n",
    "        return x\n",
    "\n",
    "def create_resnet18(num_classes=2, pretrained=True, freeze_backbone=False):\n",
    "    \"\"\"ResNet18 con transfer learning.\"\"\"\n",
    "    model = models.resnet18(pretrained=pretrained)\n",
    "    if freeze_backbone:\n",
    "        for param in model.parameters():\n",
    "            param.requires_grad = False\n",
    "    model.fc = nn.Sequential(\n",
    "        nn.Linear(512, 512),\n",
    "        nn.BatchNorm1d(512),\n",
    "        nn.ReLU(inplace=True),\n",
    "        nn.Dropout(0.5),\n",
    "        nn.Linear(512, num_classes)\n",
    "    )\n",
    "    return model\n",
    "\n",
    "def create_efficientnet_b0(num_classes=2, pretrained=True, freeze_backbone=False):\n",
    "    \"\"\"EfficientNet-B0 con transfer learning.\"\"\"\n",
    "    model = timm.create_model('efficientnet_b0', pretrained=pretrained, num_classes=0)\n",
    "    feat_dim = model.num_features\n",
    "    \n",
    "    if freeze_backbone:\n",
    "        for param in model.parameters():\n",
    "            param.requires_grad = False\n",
    "    \n",
    "    model.classifier = nn.Sequential(\n",
    "        nn.Linear(feat_dim, 512),\n",
    "        nn.BatchNorm1d(512),\n",
    "        nn.ReLU(inplace=True),\n",
    "        nn.Dropout(0.5),\n",
    "        nn.Linear(512, num_classes)\n",
    "    )\n",
    "    return model\n",
    "\n",
    "def get_model(model_name, num_classes, **kwargs):\n",
    "    \"\"\"Factory para crear modelos.\"\"\"\n",
    "    models = {\n",
    "        'CustomCNN': lambda: CustomCNN(num_classes=num_classes, **kwargs),\n",
    "        'ResNet18': lambda: create_resnet18(num_classes=num_classes, **kwargs),\n",
    "        'EfficientNet-B0': lambda: create_efficientnet_b0(num_classes=num_classes, **kwargs),\n",
    "    }\n",
    "    if model_name not in models:\n",
    "        raise ValueError(f'Modelo no soportado: {model_name}')\n",
    "    return models[model_name]()"
   ]
