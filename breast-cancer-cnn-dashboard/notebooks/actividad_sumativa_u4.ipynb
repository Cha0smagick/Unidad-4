    "# @title Optimización de hiperparámetros con Optuna\n",
    "import optuna\n",
    "from optuna.pruners import MedianPruner\n",
    "from optuna.samplers import TPESampler\n",
    "import joblib\n",
    "\n",
    "class OptunaOptimizer:\n",
    "    \"\"\"Optimizador de hiperparámetros usando Optuna.\"\"\"\n",
    "    \n",
    "    def __init__(self, model_name, device, num_classes, dataset, labels,\n",
    "                 n_trials=50, timeout=3600, k_folds=3):\n",
    "        self.model_name = model_name\n",
    "        self.device = device\n",
    "        self.num_classes = num_classes\n",
    "        self.dataset = dataset\n",
    "        self.labels = labels\n",
    "        self.n_trials = n_trials\n",
    "        self.timeout = timeout\n",
    "        self.k_folds = k_folds\n",
    "        self.study = None\n",
    "    \n",
    "    def objective(self, trial):\n",
    "        \"\"\"Función objetivo para Optuna.\"\"\"\n",
    "        # Hiperparámetros a optimizar\n",
    "        lr = trial.suggest_float('lr', 1e-5, 1e-2, log=True)\n",
    "        weight_decay = trial.suggest_float('weight_decay', 1e-6, 1e-2, log=True)\n",
    "        batch_size = trial.suggest_categorical('batch_size', [16, 32, 64])\n",
    "        dropout_rate = trial.suggest_float('dropout_rate', 0.2, 0.7)\n",
    "        \n",
    "        # Parámetros específicos por modelo\n",
    "        if self.model_name == 'CustomCNN':\n",
    "            base_filters = trial.suggest_categorical('base_filters', [16, 32, 64])\n",
    "            n_layers = trial.suggest_int('n_layers', 3, 5)\n",
    "            model_kwargs = {\n",
    "                'base_filters': base_filters,\n",
    "                'filter_progression': [base_filters * (2**i) for i in range(n_layers)],\n",
    "                'dropout_rate': dropout_rate,\n",
    "            }\n",
    "            model_fn = lambda: CustomCNN(num_classes=self.num_classes, **model_kwargs)\n",
    "        elif self.model_name == 'ResNet18':\n",
    "            freeze_backbone = trial.suggest_categorical('freeze_backbone', [True, False])\n",
    "            model_fn = lambda: create_resnet18(num_classes=self.num_classes, freeze_backbone=freeze_backbone)\n",
    "        elif self.model_name == 'EfficientNet-B0':\n",
    "            freeze_backbone = trial.suggest_categorical('freeze_backbone', [True, False])\n",
    "            model_fn = lambda: create_efficientnet_b0(num_classes=self.num_classes, freeze_backbone=freeze_backbone)\n",
    "        \n",
    "        # K-Fold simplificado para optimización (menos folds = más rápido)\n",
    "        skf = StratifiedKFold(n_splits=self.k_folds, shuffle=True, random_state=42)\n",
    "        fold_scores = []\n",
    "        \n",
    "        for fold_idx, (train_idx, val_idx) in enumerate(skf.split(np.arange(len(self.dataset)), self.labels)):\n",
    "            train_subset = Subset(self.dataset, train_idx)\n",
    "            val_subset = Subset(self.dataset, val_idx)\n",
    "            \n",
    "            train_loader = DataLoader(train_subset, batch_size=batch_size, shuffle=True, num_workers=2)\n",
    "            val_loader = DataLoader(val_subset, batch_size=batch_size, shuffle=False, num_workers=2)\n",
    "            \n",
    "            model = model_fn().to(self.device)\n",
    "            criterion = nn.CrossEntropyLoss()\n",
    "            optimizer = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=weight_decay)\n",
    "            \n",
    "            # Entrenamiento rápido (pocas épocas para optimización)\n",
    "            model.train()\n",
    "            for epoch in range(10):  # Solo 10 epochs para optimización\n",
    "                for images, labels_batch in train_loader:\n",
    "                    images, labels_batch = images.to(self.device), labels_batch.to(self.device)\n",
    "                    optimizer.zero_grad()\n",
    "                    outputs = model(images)\n",
    "                    loss = criterion(outputs, labels_batch)\n",
    "                    loss.backward()\n",
    "                    optimizer.step()\n",
    "            \n",
    "            # Evaluar\n",
    "            model.eval()\n",
    "            val_preds = []\n",
    "            val_labels = []\n",
    "            with torch.no_grad():\n",
    "                for images, labels_batch in val_loader:\n",
    "                    images = images.to(self.device)\n",
    "                    outputs = model(images)\n",
    "                    preds = outputs.argmax(dim=1).cpu().numpy()\n",
    "                    val_preds.extend(preds)\n",
    "                    val_labels.extend(labels_batch.numpy())\n",
    "            \n",
    "            fold_f1 = f1_score(val_labels, val_preds, average='macro', zero_division=0)\n",
    "            fold_scores.append(fold_f1)\n",
    "        \n",
    "        return np.mean(fold_scores)\n",
    "    \n",
    "    def optimize(self):\n",
    "        \"\"\"Ejecuta la optimización.\"\"\"\n",
    "        self.study = optuna.create_study(\n",
    "            direction='maximize',\n",
    "            sampler=TPESampler(seed=42),\n",
    "            pruner=MedianPruner(n_startup_trials=5, n_warmup_steps=3)\n",
    "        )\n",
    "        \n",
    "        self.study.optimize(self.objective, n_trials=self.n_trials, timeout=self.timeout)\n",
    "        \n",
    "        print(f'\\nMejores hiperparámetros para {self.model_name}:')\n",
    "        for key, value in self.study.best_params.items():\n",
    "            print(f'  {key}: {value}')\n",
    "        print(f'Mejor F1-score (CV): {self.study.best_value:.4f}')\n",
    "        \n",
    "        # Guardar estudio\n",
    "        joblib.dump(self.study, f'optuna_study_{self.model_name}.pkl')\n",
    "        \n",
    "        return self.study.best_params"
   ]
