    "# @title Implementación de K-Fold Cross Validation\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from torch.utils.data import Subset\n",
    "import copy\n",
    "\n",
    "class KFoldTrainer:\n",
    "    \"\"\"Entrenador con K-Fold Cross Validation.\"\"\"\n",
    "    \n",
    "    def __init__(self, model_fn, device, num_classes, k_folds=5, \n",
    "                 epochs=30, lr=1e-3, weight_decay=1e-4,\n",
    "                 early_stopping_patience=10, verbose=True):\n",
    "        self.model_fn = model_fn\n",
    "        self.device = device\n",
    "        self.num_classes = num_classes\n",
    "        self.k_folds = k_folds\n",
    "        self.epochs = epochs\n",
    "        self.lr = lr\n",
    "        self.weight_decay = weight_decay\n",
    "        self.early_stopping_patience = early_stopping_patience\n",
    "        self.verbose = verbose\n",
    "    \n",
    "    def train_fold(self, model, train_loader, val_loader, fold_idx):\n",
    "        \"\"\"Entrena un fold individual.\"\"\"\n",
    "        model.to(self.device)\n",
    "        \n",
    "        criterion = nn.CrossEntropyLoss()\n",
    "        optimizer = torch.optim.AdamW(model.parameters(), lr=self.lr, weight_decay=self.weight_decay)\n",
    "        scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "            optimizer, mode='min', factor=0.5, patience=5, min_lr=1e-6\n",
    "        )\n",
    "        \n",
    "        best_val_loss = float('inf')\n",
    "        patience_counter = 0\n",
    "        best_model_state = None\n",
    "        history = {'train_loss': [], 'train_acc': [], 'val_loss': [], 'val_acc': []}\n",
    "        \n",
    "        for epoch in range(self.epochs):\n",
    "            # Training\n",
    "            model.train()\n",
    "            train_loss = 0.0\n",
    "            train_correct = 0\n",
    "            train_total = 0\n",
    "            \n",
    "            for images, labels in train_loader:\n",
    "                images, labels = images.to(self.device), labels.to(self.device)\n",
    "                optimizer.zero_grad()\n",
    "                outputs = model(images)\n",
    "                loss = criterion(outputs, labels)\n",
    "                loss.backward()\n",
    "                optimizer.step()\n",
    "                \n",
    "                train_loss += loss.item()\n",
    "                _, predicted = outputs.max(1)\n",
    "                train_correct += predicted.eq(labels).sum().item()\n",
    "                train_total += labels.size(0)\n",
    "            \n",
    "            train_acc = 100. * train_correct / train_total\n",
    "            avg_train_loss = train_loss / len(train_loader)\n",
    "            \n",
    "            # Validation\n",
    "            model.eval()\n",
    "            val_loss = 0.0\n",
    "            val_correct = 0\n",
    "            val_total = 0\n",
    "            \n",
    "            with torch.no_grad():\n",
    "                for images, labels in val_loader:\n",
    "                    images, labels = images.to(self.device), labels.to(self.device)\n",
    "                    outputs = model(images)\n",
    "                    loss = criterion(outputs, labels)\n",
    "                    val_loss += loss.item()\n",
    "                    _, predicted = outputs.max(1)\n",
    "                    val_correct += predicted.eq(labels).sum().item()\n",
    "                    val_total += labels.size(0)\n",
    "            \n",
    "            val_acc = 100. * val_correct / val_total\n",
    "            avg_val_loss = val_loss / len(val_loader)\n",
    "            \n",
    "            scheduler.step(avg_val_loss)\n",
    "            \n",
    "            history['train_loss'].append(avg_train_loss)\n",
    "            history['train_acc'].append(train_acc)\n",
    "            history['val_loss'].append(avg_val_loss)\n",
    "            history['val_acc'].append(val_acc)\n",
    "            \n",
    "            # Early stopping\n",
    "            if avg_val_loss < best_val_loss:\n",
    "                best_val_loss = avg_val_loss\n",
    "                patience_counter = 0\n",
    "                best_model_state = copy.deepcopy(model.state_dict())\n",
    "            else:\n",
    "                patience_counter += 1\n",
    "                if patience_counter >= self.early_stopping_patience:\n",
    "                    if self.verbose:\n",
    "                        print(f'  Fold {fold_idx}: Early stopping at epoch {epoch+1}')\n",
    "                    break\n",
    "            \n",
    "            if self.verbose and (epoch + 1) % 5 == 0:\n",
    "                print(f'  Fold {fold_idx} Epoch {epoch+1}: Train Loss={avg_train_loss:.4f}, Train Acc={train_acc:.2f}%, Val Loss={avg_val_loss:.4f}, Val Acc={val_acc:.2f}%')\n",
    "        \n",
    "        # Restaurar mejor modelo\n",
    "        if best_model_state:\n",
    "            model.load_state_dict(best_model_state)\n",
    "        \n",
    "        return model, history, best_val_loss\n",
    "    \n",
    "    def run_kfold(self, dataset, labels, batch_size=32):\n",
    "        \"\"\"Ejecuta K-Fold cross validation.\"\"\"\n",
    "        skf = StratifiedKFold(n_splits=self.k_folds, shuffle=True, random_state=42)\n",
    "        \n",
    "        fold_results = []\n",
    "        fold_histories = []\n",
    "        \n",
    "        for fold_idx, (train_idx, val_idx) in enumerate(skf.split(np.arange(len(dataset)), labels)):\n",
    "            if self.verbose:\n",
    "                print(f'\\n=== Fold {fold_idx + 1}/{self.k_folds} ===')\n",
    "            \n",
    "            # Crear subsets\n",
    "            train_subset = Subset(dataset, train_idx)\n",
    "            val_subset = Subset(dataset, val_idx)\n",
    "            \n",
    "            train_loader = DataLoader(train_subset, batch_size=batch_size, shuffle=True, num_workers=2, pin_memory=True)\n",
    "            val_loader = DataLoader(val_subset, batch_size=batch_size, shuffle=False, num_workers=2, pin_memory=True)\n",
    "            \n",
    "            # Crear modelo fresco para cada fold\n",
    "            model = self.model_fn()\n",
    "            \n",
    "            # Entrenar\n",
    "            model, history, best_val_loss = self.train_fold(model, train_loader, val_loader, fold_idx + 1)\n",
    "            \n",
    "            # Evaluar en validation\n",
    "            model.eval()\n",
    "            all_preds = []\n",
    "            all_labels = []\n",
    "            all_probs = []\n",
    "            \n",
    "            with torch.no_grad():\n",
    "                for images, labels_batch in val_loader:\n",
    "                    images = images.to(self.device)\n",
    "                    outputs = model(images)\n",
    "                    probs = torch.softmax(outputs, dim=1)\n",
    "                    preds = outputs.argmax(dim=1).cpu().numpy()\n",
    "                    \n",
    "                    all_preds.extend(preds)\n",
    "                    all_labels.extend(labels_batch.numpy())\n",
    "                    all_probs.extend(probs.cpu().numpy())\n",
    "            \n",
    "            # Calcular métricas\n",
    "            from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score, confusion_matrix\n",
    "            \n",
    "            metrics = {\n",
    "                'fold': fold_idx + 1,\n",
    "                'accuracy': accuracy_score(all_labels, all_preds),\n",
    "                'precision': precision_score(all_labels, all_preds, average='macro', zero_division=0),\n",
    "                'recall': recall_score(all_labels, all_preds, average='macro', zero_division=0),\n",
    "                'f1': f1_score(all_labels, all_preds, average='macro', zero_division=0),\n",
    "                'roc_auc': roc_auc_score(all_labels, np.array(all_probs), multi_class='ovr') if self.num_classes > 2 else roc_auc_score(all_labels, [p[1] for p in all_probs]),\n",
    "                'confusion_matrix': confusion_matrix(all_labels, all_preds).tolist(),\n",
    "                'best_val_loss': best_val_loss\n",
    "            }\n",
    "            \n",
    "            fold_results.append(metrics)\n",
    "            fold_histories.append(history)\n",
    "            \n",
    "            if self.verbose:\n",
    "                print(f'  Fold {fold_idx+1} Results: Acc={metrics[\"accuracy\"]:.4f}, F1={metrics[\"f1\"]:.4f}, AUC={metrics[\"roc_auc\"]:.4f}')\n",
    "        \n",
    "        # Promediar resultados\n",
    "        avg_metrics = {}\n",
    "        for key in ['accuracy', 'precision', 'recall', 'f1', 'roc_auc', 'best_val_loss']:\n",
    "            values = [r[key] for r in fold_results]\n",
    "            avg_metrics[f'{key}_mean'] = np.mean(values)\n",
    "            avg_metrics[f'{key}_std'] = np.std(values)\n",
    "        \n",
    "        return {\n",
    "            'fold_results': fold_results,\n",
    "            'fold_histories': fold_histories,\n",
    "            'avg_metrics': avg_metrics\n",
    "        }"
   ]
  },
