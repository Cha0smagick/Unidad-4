    "# @title Análisis de clases y balance\n",
    "# Identificar columna de patología (target)\n",
    "# CBIS-DDSM típicamente tiene: pathology (BENIGN, BENIGN_WITHOUT_CALLBACK, MALIGNANT)\n",
    "\n",
    "# Buscar archivos DICOM\n",
    "dcm_files = []\n",
    "for root, dirs, files in os.walk(path):\n",
    "    for f in files:\n",
    "        if f.endswith('.dcm') or f.endswith('.dicom'):\n",
    "            dcm_files.append(os.path.join(root, f))\n",
    "\n",
    "print(f'Total archivos DICOM: {len(dcm_files)}')\n",
    "\n",
    "# Si hay metadatos CSV principal, analizar\n",
    "if csv_files:\n",
    "    main_csv = max(csv_files, key=lambda x: os.path.getsize(x))\n",
    "    df_main = pd.read_csv(main_csv)\n",
